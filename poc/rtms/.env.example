# poc/rtms の設定。`cp .env.example .env` して値を埋める（.env は .gitignore 済み・本物の値は絶対に commit しない）。
# 読むのは src/config.ts の 1 か所だけ。

# --- Zoom アプリ（開発用に新規作成した General App。審査済みの本番アプリは使わない） ---
# Marketplace > Manage > 該当アプリ > Basic Information > App Credentials
ZOOM_RTMS_CLIENT_ID=
ZOOM_RTMS_CLIENT_SECRET=
# 同 > Access（Features）> Event Subscription の Secret Token。webhook の署名検証と URL 検証に使う
ZOOM_WEBHOOK_SECRET_TOKEN=

# --- 受信サーバー ---
# 待ち受けポート。8888 / 3000 / 3123 はこのリポジトリの他のツールが使うので避ける
PORT=3400
# webhook のパス。Zoom 側の Event notification endpoint URL は https://<トンネルのホスト>/webhook
WEBHOOK_PATH=/webhook
# x-zm-request-timestamp の許容ずれ（秒）。Zoom の公式サンプルと同じ 300 秒
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

# --- 音声の保存 ---
# 保存先（会議ごとにサブディレクトリ）。既定は poc/rtms/out
RTMS_OUT_DIR=./out
# 1 ファイルの長さ（秒）。本番設計（T-209）と同じ 15 分。オフライン確認では 5 などに縮めると分割が見える
RTMS_CHUNK_SECONDS=900
# webhook 受信〜接続完了までの音声を Zoom 側で溜めて送ってもらうか（既定 true。false は冒頭を捨てる）
RTMS_BUFFER_DATA=true

# --- 文字起こしへの受け渡し（#393 の PoC・PR #474） ---
# 空なら受け渡しをしない（保存だけ）。poc/stt を入れてあるなら `../stt/.venv/bin/python`
STT_PYTHON=
# transcribe.py の場所（poc/rtms からの相対か絶対パス）
STT_SCRIPT=../stt/transcribe.py
# faster-whisper のモデル（CPU なら small。#393 の計測で medium は CPU では成立しない）
STT_MODEL=small
