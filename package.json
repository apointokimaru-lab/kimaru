{
  "name": "kimaru-production-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "netlify dev",
    "dev:next": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "i18n:split": "node scripts/i18n/split.mjs",
    "i18n:check": "node scripts/i18n/split.mjs --check",
    "ci": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm test",
    "deploy": "netlify deploy --prod",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node scripts/test/unit.mjs && tsx --test \"app/**/*.test.ts\" \"components/**/*.test.ts\" \"features/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "test:e2e": "node scripts/test/e2e.mjs && playwright test"
  },
  "dependencies": {
    "next": "^16.3.4",
    "nodemailer": "^9.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@netlify/plugin-nextjs": "^5.15.13",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "playwright": "^1.61.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
