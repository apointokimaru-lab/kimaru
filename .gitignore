# Local Netlify folder
.netlify

# Node dependencies（package.json から復元・Netlifyがbuild時にinstall）
node_modules

# Local env (never commit secrets)
.env
.env.*
!.env.example

# Next.js（#412 で導入）。ビルド出力と、next が自動生成する型定義
.next
next-env.d.ts
*.tsbuildinfo

# Playwright（@playwright/test）の出力
playwright-report
test-results

# WSL で外部ツールが Windows のパス文字列をそのままディレクトリ名にすることがある（chrome-launcher 等）
C:*
*wsl.localhost*
