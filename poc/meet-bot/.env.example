# poc/meet-bot の設定（コピーして .env にする。.env は .gitignore 済み）
# 値はすべて省略可。省略時の既定値は src/config.ts。

# 人が一度ログインした Chromium のプロファイル置き場（`npx tsx src/cli.ts login` が作る）。
# Google の Cookie が入るので、共有ディレクトリや git 管理下に置かない。
MEET_PROFILE_DIR=./profile

# 録音・manifest・スクリーンショットの出力先。会議ごとに <日時>-<会議コード>/ が作られる
MEET_OUT_DIR=./out

# 安全タイムアウト（秒）。これを超えたら会議が続いていても退出する。上限 14400（4 時間）。それ以上は指定しても 14400 に丸める
MEET_MAX_SECONDS=14400

# 待機室（「参加をリクエスト」後に承認を待つ）の上限秒。本番設計 FR-2.2 と同じ 15 分
MEET_WAITING_ROOM_SECONDS=900

# 参加者が Bot だけ（1 人以下）になってから退出するまでの秒数。本番設計 FR-2.7 の 5〜10 分の下限
MEET_ALONE_SECONDS=300

# WAV 1 本の長さ（秒）。本番設計 T-209 の 15 分。テストでは短くする
MEET_CHUNK_SECONDS=900

# 文字起こし（#393 の poc/stt/transcribe.py）を呼ぶ Python。未設定なら文字起こしは飛ばす（録音だけ）。
# 例: ../stt/.venv/bin/python
STT_PYTHON=
# transcribe.py の場所（既定は同じリポジトリの poc/stt/transcribe.py）
STT_SCRIPT=../stt/transcribe.py
# transcribe.py に足す引数（空白区切り）。例: --model small --threads 4
STT_ARGS=--model small --threads 4
# 文字起こしのタイミング。after（既定）＝退出してブラウザを閉じてから直列に回す／during＝チャンクが閉じるたび会議中に回す。
# 同じ PC で during にすると faster-whisper が CPU を取って録音側の音声が途切れたので、手元では after にする
STT_WHEN=after

# 1 = ヘッドレス（既定）。0 にすると画面を出す（WSLg 等の DISPLAY が必要）
MEET_HEADLESS=1
# Playwright の channel。"chromium"（新ヘッドレス・login と同じ実体）か "chromium-headless-shell"
MEET_BROWSER_CHANNEL=chromium

# 1 にすると Chromium に「無音のマイク」を持たせる（--use-fake-device-for-media-stream ＋ 無音 WAV）。
# 既定はデバイス無し。Meet が「マイクが見つかりません」で参加ボタンを出さない場合の予備
MEET_FAKE_DEVICES=0
